# Google Analytics 4 — get this from analytics.google.com
# Admin → Data streams → your web stream → Measurement ID
# Optional — only needed to point at a different GA property.
# The production ID ships as the default in src/components/Analytics.jsx
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Password gate for the private tools at /expense and /ask.
# If unset, those routes stay locked with no valid password.
VITE_TOOLS_PASSWORD=
